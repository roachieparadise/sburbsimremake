	<classpathentry kind="src" path="backend/java/modelss"/>
	<classpathentry kind="src" path="backend/java/repo"/>
	<classpathentry kind="src" path="backend/java/sservice"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
